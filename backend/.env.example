# Copy to backend/.env and fill in. Never commit the real .env (gitignored).
#
# GitHub OAuth App: https://github.com/settings/developers
# Set its "Authorization callback URL" to exactly GITHUB_REDIRECT_URI below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional — defaults shown are correct for local dev.
# GITHUB_REDIRECT_URI=http://127.0.0.1:8000/auth/github/callback
# FRONTEND_URL=http://localhost:5173

# Optional — without it, a random key is generated per process start, which
# invalidates all existing sessions on every restart.
# AQUAVIGIL_SECRET_KEY=
